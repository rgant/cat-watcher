{% extends "base.html.jinja" %}
{% block title %}
  Timeline · Cat Watcher
{% endblock title %}
{% block content %}
  {% set lane_height = 36 %}
  {% set viewport_width = 1000 %}
  {% set track_width = viewport_width - label_width %}
  {% set axis_height = 22 %}
  {% set svg_height = (lanes|length * lane_height) + axis_height %}
  <section id="timeline-region" aria-label="Activity timeline">
    {% if not storage_online %}
      <p class="banner banner-offline"
         role="status"
         aria-live="polite">External storage offline — clip playback and thumbnails unavailable.</p>
    {% endif %}
    <header class="timeline-header">
      <h1>Timeline</h1>
      {% for nav_label, links in [("Timeline range", range_links), ("Lanes", lane_links), ("Strip clips", strip_links)] %}
        <nav class="range-presets" aria-label="{{ nav_label }}">
          {% for link in links %}
            <a href="{{ link.href }}"
               hx-get="{{ link.href }}"
               hx-target="#timeline-region"
               hx-select="#timeline-region"
               hx-swap="outerHTML"
               hx-indicator="#timeline-region"
               hx-push-url="true"
               {% if link.current %}aria-current="page"{% endif %}>{{ link.label }}</a>
          {% endfor %}
        </nav>
      {% endfor %}
    </header>
    {% if not window_has_clips %}
      <div class="empty-state">
        <svg class="empty-icon"
             viewBox="0 0 48 48"
             role="presentation"
             aria-hidden="true">
          <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="1.5" />
          <line x1="14" y1="14" x2="34" y2="34" stroke="currentColor" stroke-width="1.5" />
        </svg>
        <h2>No activity in this range</h2>
        <p>Try a longer range, or check that the cameras are reachable from the host.</p>
        <p class="empty-ctas">
          {% if next_longer_range_key %}
            <a class="empty-cta-next-longer-range"
               href="{{ next_longer_range_url }}">Show {{ next_longer_range_key }}</a>
          {% endif %}
          <a class="empty-cta-cameras" href="{{ url_for('cameras_page') }}">Cameras →</a>
        </p>
      </div>
    {% else %}
      {% if no_cat_visited %}
        <div class="empty-state">
          <h2>No cat visited in this range</h2>
          <p>The cameras recorded clips, but none of them is a cat clip.</p>
          <p class="empty-ctas">
            <a class="empty-cta-box-view" href="{{ box_view_url }}">Show the camera view</a>
          </p>
        </div>
      {% else %}
        <svg viewBox="0 0 {{ viewport_width }} {{ svg_height }}"
             preserveAspectRatio="xMidYMid meet"
             class="timeline-svg"
             role="img"
             aria-label="Activity over the last {{ range_key }}">
          {% for lane in lanes %}
            {% set lane_y = loop.index0 * lane_height %}
            <g class="lane" data-lane-key="{{ lane.key }}">
            <text x="0" y="{{ lane_y + lane_height / 2 }}" dominant-baseline="middle" class="lane-label">{{ lane.label }}</text>
            <line x1="{{ label_width }}" x2="{{ viewport_width }}" y1="{{ lane_y + lane_height / 2 }}" y2="{{ lane_y + lane_height / 2 }}" class="lane-axis"></line>
            {# The markers have no SVG <title>. The browser shows a <title> as a native hover tooltip.
          That tooltip covers the .timeline-tooltip from timeline.js. The aria-label on the <a> wrapper
          gives the marker its accessible name. #}
            {% for clip in lane.markers %}
              {% set rect_x = label_width + clip.x_frac * track_width %}
              {% set rect_w = [clip.w_frac * track_width, 2]|max %}
              <a href="{{ url_for('clip_detail', clip_id=clip.id) }}"
                 aria-label="{{ clip.camera_display_name }} · {{ clip.display_start }} · score {{ '%.2f'|format(clip.max_score) }}">
                <rect class="{{ clip.css_classes }}" {% if clip.lane_color %}style="--lane-color: {{ clip.lane_color }};"{% endif %} x="{{ rect_x }}" y="{{ lane_y + 12 }}" width="{{ rect_w }}" height="{{ lane_height - 24 }}" data-clip-id="{{ clip.id }}" data-camera="{{ clip.camera_display_name }}" data-start="{{ clip.display_start }}" data-score="{{ '%.2f'|format(clip.max_score) }}"></rect>
              </a>
            {% endfor %}
            </g>
          {% endfor %}
          {% for alert in alerts %}
            {% set ax = label_width + alert.x_frac * track_width %}
            <g class="alert-marker" data-alert-type="{{ alert.alert_type }}">
            <line x1="{{ ax }}" x2="{{ ax }}" y1="0" y2="{{ lanes|length * lane_height }}" class="alert-line"></line>
            <text x="{{ ax + 4 }}" y="14" class="alert-label">{{ alert.alert_type }}</text>
            </g>
          {% endfor %}
          {% set axis_y = lanes|length * lane_height %}
          <g class="time-axis">
          {% for mark in time_axis_marks %}
            {% set mark_x = label_width + mark.x_frac * track_width %}
            {% if mark.kind == "tick" %}
              <line class="axis-tick" x1="{{ mark_x }}" x2="{{ mark_x }}" y1="{{ axis_y }}" y2="{{ axis_y + 6 }}"></line>
              {% if mark.label %}
                <text class="axis-tick-label" x="{{ mark_x }}" y="{{ axis_y + 16 }}" text-anchor="middle">{{ mark.label }}</text>
              {% endif %}
            {% elif mark.kind == "day" %}
              <line class="axis-day-boundary" x1="{{ mark_x }}" x2="{{ mark_x }}" y1="0" y2="{{ axis_y + 4 }}"></line>
              {% if mark.label %}
                <text class="axis-day-label" x="{{ mark_x + 3 }}" y="11">{{ mark.label }}</text>
              {% endif %}
            {% elif mark.kind == "now" %}
              <line class="axis-now" x1="{{ mark_x }}" x2="{{ mark_x }}" y1="0" y2="{{ axis_y + 4 }}"></line>
              <circle class="axis-now-dot" cx="{{ mark_x }}" cy="3" r="3"></circle>
            {% endif %}
          {% endfor %}
          </g>
        </svg>
      {% endif %}
      {% if not thumb_cards and not no_cat_visited and all_clips_url %}
        <p class="empty-strip">
          No cat clips in this range.
          <a class="empty-cta-all-clips" href="{{ all_clips_url }}">Show all clips</a>
        </p>
      {% endif %}
      <ul class="thumb-strip" aria-label="Recent clip thumbnails">
        {% for clip in thumb_cards %}
          <li class="{{ clip.css_classes }}">
            <a href="{{ url_for('clip_detail', clip_id=clip.id) }}">
              <span class="thumb-frame">
                <img src="{{ url_for('media_thumb', clip_id=clip.id) }}"
                     alt="Clip from {{ clip.camera_display_name }} at {{ clip.display_start }}"
                     loading="lazy"
                     onerror="this.src='{{ url_for('static', path=hashed_static_path('clip-placeholder.svg')) }}'; this.onerror = null;">
                <span class="thumb-meta">
                  <span class="thumb-camera">{{ clip.camera_display_name }}</span>
                  <span class="thumb-time">{{ clip.display_start }}</span>
                </span>
              </span>
              <span class="thumb-cats">
                {% with chips=clip.identity_chips, fallback_label=clip.identity_fallback_label %}
                  {% include "_clip_identity.html.jinja" %}
                {% endwith %}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
      {% if strip_page.show_controls %}
        <nav class="pagination" aria-label="Strip pages">
          {% if previous_page_url %}
            <a href="{{ previous_page_url }}"
               hx-get="{{ previous_page_url }}"
               hx-target="#timeline-region"
               hx-select="#timeline-region"
               hx-swap="outerHTML"
               hx-indicator="#timeline-region"
               hx-push-url="true"
               rel="prev">← Previous</a>
          {% else %}
            <span class="pagination-disabled" aria-disabled="true">← Previous</span>
          {% endif %}
          <span>Page {{ strip_page.number }} of {{ strip_page.page_count }}</span>
          {% if next_page_url %}
            <a href="{{ next_page_url }}"
               hx-get="{{ next_page_url }}"
               hx-target="#timeline-region"
               hx-select="#timeline-region"
               hx-swap="outerHTML"
               hx-indicator="#timeline-region"
               hx-push-url="true"
               rel="next">Next →</a>
          {% else %}
            <span class="pagination-disabled" aria-disabled="true">Next →</span>
          {% endif %}
        </nav>
      {% endif %}
    {% endif %}
  </section>
  <script src="{{ url_for('static', path=hashed_static_path('timeline.js')) }}"
          defer></script>
{% endblock content %}
