{% extends "base.html.jinja" %}
{% block title %}
  Clip {{ clip.id }} · Cat Watcher
{% endblock title %}
{% block body_attrs %}
  data-no-auto-refresh
{% endblock body_attrs %}
{% block content %}
  <nav class="clip-nav" aria-label="Clip navigation">
    {% if prev_url %}
      <a href="{{ prev_url }}" rel="prev">← Newer</a>
    {% elif prev_clip_id %}
      <a href="{{ url_for('clip_detail', clip_id=prev_clip_id) }}" rel="prev">← Newer</a>
    {% else %}
      <span class="clip-nav-disabled" aria-disabled="true">← Newer</span>
    {% endif %}
    <a href="{{ url_for('list_clips') }}">All clips</a>
    {% if next_url %}
      <a href="{{ next_url }}" rel="next">Older →</a>
    {% elif next_clip_id %}
      <a href="{{ url_for('clip_detail', clip_id=next_clip_id) }}" rel="next">Older →</a>
    {% else %}
      <span class="clip-nav-disabled" aria-disabled="true">Older →</span>
    {% endif %}
  </nav>
  <header>
    <h1>
      {{ camera.display_name if camera else "(unknown camera)" }}·
      <time datetime="{{ clip.start_ts.isoformat() }}">{{ display_start }}</time>
    </h1>
  </header>
  <video controls preload="metadata" aria-label="Clip {{ clip.id }} video">
    <source src="{{ url_for('media_clip', clip_id=clip.id) }}" type="video/mp4">
    Your browser does not support HTML5 video.
  </video>
  {% if frames %}
    <section class="contact-sheet" aria-labelledby="contact-sheet-heading">
      <h2 id="contact-sheet-heading" class="sr-only">Frames</h2>
      <ol class="contact-sheet-list">
        {% for frame in frames %}
          <li>
            <button type="button"
                    class="contact-sheet-button"
                    data-seek-seconds="{{ frame.t_offset_seconds }}"
                    aria-label="Jump to {{ frame.display_offset }}">
              <img src="{{ url_for('media_frame', frame_id=frame.id) }}"
                   alt="Frame at {{ frame.display_offset }}"
                   loading="lazy"
                   width="320"
                   height="180">
              <span class="contact-sheet-time">{{ frame.display_offset }}</span>
              <span class="{{ 'contact-sheet-score contact-sheet-score-below' if frame.below_threshold else 'contact-sheet-score' }}">{{ frame.display_score }}</span>
            </button>
          </li>
        {% endfor %}
      </ol>
    </section>
    <section class="tag-table" aria-labelledby="tag-table-heading">
      <h2 id="tag-table-heading" class="sr-only">Frame labels</h2>
      <div class="tag-table-toolbar">
        <button type="button"
                id="kbd-help-open"
                class="kbd-help-open"
                aria-haspopup="dialog"
                aria-label="Keyboard shortcuts"
                title="Keyboard shortcuts (?)">?</button>
      </div>
      <div class="tag-table-scroll">
        <table>
          <tbody>
            {% for row in frame_tag_rows %}
              <tr class="{{ 'tag-row active-frame' if loop.first else 'tag-row' }}">
                <td class="tag-row-thumb">
                  <img src="{{ url_for('media_frame', frame_id=row.frame.id) }}"
                       alt="Frame {{ row.frame.ordinal }}"
                       loading="lazy"
                       width="160"
                       height="90">
                </td>
                {% for group in row.button_groups %}
                  <td class="tag-btn-group tag-btn-group-{{ group.kind }}">
                    {% for btn in group.buttons %}
                      {% if btn.hx_put %}
                        <button type="button"
                                class="{{ btn.button_class }}"
                                data-subject-slug="{{ btn.slug }}"
                                data-frame-id="{{ btn.frame_id }}"
                                data-subject-id="{{ btn.subject_id }}"
                                title="{{ btn.title }}"
                                aria-label="{{ btn.title }}"
                                aria-pressed="false"
                                hx-put="{{ btn.hx_put }}"
                                hx-swap="none"
                                hx-disabled-elt="this"
                                hx-on::after-request="handleTagResponse(event, this)"
                                {% if btn.color %}
                                  style="border-color: {{ btn.color }};"
                                {% endif %}>{{ btn.label }}</button>
                      {% endif %}
                      {% if btn.hx_delete %}
                        <button type="button"
                                class="{{ btn.button_class }}"
                                data-subject-slug="{{ btn.slug }}"
                                data-frame-id="{{ btn.frame_id }}"
                                data-subject-id="{{ btn.subject_id }}"
                                title="{{ btn.title }}"
                                aria-label="{{ btn.title }}"
                                aria-pressed="true"
                                hx-delete="{{ btn.hx_delete }}"
                                hx-swap="none"
                                hx-disabled-elt="this"
                                hx-on::after-request="handleTagResponse(event, this)"
                                {% if btn.color %}
                                  style="border-color: {{ btn.color }};"
                                {% endif %}>{{ btn.label }}</button>
                      {% endif %}
                    {% endfor %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}
  <div class="review-control">
    {% if review_hx_method == "post" %}
      <button type="button"
              id="review-btn"
              hx-post="{{ reviewed_url }}"
              hx-swap="none"
              hx-disabled-elt="this"
              hx-on::after-request="handleReviewResponse(event, this)">Mark reviewed</button>
    {% else %}
      <button type="button"
              id="review-btn"
              hx-delete="{{ reviewed_url }}"
              hx-swap="none"
              hx-disabled-elt="this"
              hx-on::after-request="handleReviewResponse(event, this)">Re-open for review</button>
      <span class="review-badge">Reviewed {{ reviewed_at_short }}</span>
    {% endif %}
  </div>
  <section aria-labelledby="detection-heading">
    <h2 id="detection-heading">Detection</h2>
    <dl class="detail-meta">
      <dt>has_cat</dt>
      <dd>
        {{ clip.has_cat }}
      </dd>
      <dt>max_score</dt>
      <dd>
        {{ "%.3f"|format(clip.max_score) }}
      </dd>
      <dt>frames</dt>
      <dd>
        {{ clip.frames_with_cat }} / {{ clip.frames_sampled }}
      </dd>
      <dt>detector_version</dt>
      <dd>
        <code>{{ clip.detector_version }}</code>
      </dd>
      <dt>analysis_error</dt>
      <dd>
        {% if clip.analysis_error %}
          <span class="badge-error">{{ clip.analysis_error }}</span>
        {% else %}
          —
        {% endif %}
      </dd>
      <dt>reviewed_at</dt>
      <dd id="detail-reviewed-at">
        {% if reviewed_at_iso %}
          <time datetime="{{ reviewed_at_iso }}">{{ reviewed_at_iso }}</time>
        {% else %}
          —
        {% endif %}
      </dd>
      <dt>has_manual_cat</dt>
      <dd id="detail-has-manual-cat">
        {{ "Yes" if has_manual_cat else "No" }}
      </dd>
      <dt>tag_summary</dt>
      <dd id="detail-tag-summary" data-clip-id="{{ clip.id }}">
        {{ tag_summary }}
      </dd>
    </dl>
  </section>
  <script src="{{ url_for('static', path='clip_detail.js') }}" defer></script>
  <script src="{{ url_for('static', path='clip_detail_keyboard.js') }}" defer></script>
  <dialog id="kbd-help" class="kbd-help" aria-label="Keyboard shortcuts">
    <form method="dialog">
      <button type="submit" class="kbd-help-close" aria-label="Close">×</button>
    </form>
    <h2>Keyboard shortcuts</h2>
    <table>
      <tbody>
        {% set ns = namespace(digit=1) %}
        {% for kind, subjects in subjects_by_kind.items() %}
          {% for subj in subjects %}
            <tr>
              <td>
                {% if ns.digit <= 9 %}
                  <kbd>{{ ns.digit }}</kbd>
                {% else %}
                  —
                {% endif %}
              </td>
              <td>{{ subj.display_name }}</td>
              <td>{{ kind }}</td>
            </tr>
            {% set ns.digit = ns.digit + 1 %}
          {% endfor %}
        {% endfor %}
        <tr>
          <td>
            <kbd>↑</kbd> / <kbd>↓</kbd>
          </td>
          <td>Move active frame</td>
          <td></td>
        </tr>
        <tr>
          <td>
            <kbd>→</kbd> / <kbd>←</kbd>
          </td>
          <td>Next / previous clip</td>
          <td></td>
        </tr>
        <tr>
          <td>
            <kbd>r</kbd>
          </td>
          <td>Mark reviewed / Re-open</td>
          <td></td>
        </tr>
        <tr>
          <td>
            <kbd>?</kbd>
          </td>
          <td>Toggle this overlay</td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </dialog>
{% endblock content %}
